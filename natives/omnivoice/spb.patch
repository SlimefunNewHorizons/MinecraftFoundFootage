 static int backend_cpu_n_threads(void) {
+    // Local benchmark override: OV_THREADS=<n> forces the CPU thread count.
+    if (const char * env = std::getenv("OV_THREADS")) {
+        int forced = std::atoi(env);
+        if (forced > 0) return forced;
+    }
